/**
 * 反響の入り口一覧。新しい経路（自社ホームページの問い合わせフォーム等）は
 * ここに1行足すだけで対応できる。
 *
 *  名称     … シートの「反響経路」に書く文字列のもと
 *  差出人   … Fromに対する正規表現
 *  番号有無 … true だと「suumo（番号あり）/（番号無し）」のように
 *             電話番号の有無を後ろに付ける
 *  形式     … 'suumo' | 'athome' | '汎用'（解析時の細かい癖の切り替え）
 */
function 反響元一覧_() {
  return [
    { 名称: 'suumo',        差出人: /jds\.suumo\.jp/i,  番号有無: true,  形式: 'suumo'  },
    { 名称: 'アットホーム', 差出人: /athome\.jp/i,      番号有無: true,  形式: 'athome' },

    // ★ 自社ホームページの問い合わせフォームからの通知メールの差出人に直すこと。
    //   実際のメールを1通見て、From を正規表現にすれば動く。
    //   06_テスト.gs の テスト_生メールを見る() で確認できる。
    { 名称: 'ホームページ', 差出人: /★まだ設定していません/, 番号有無: true, 形式: '汎用' },
  ];
}

