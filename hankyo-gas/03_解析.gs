/**
 * 03_解析.gs … 反響メール1通を項目に分解する
 *
 * 全角・半角の揺れ（ＴＥＬ／TEL、：／:、全角スペースの桁揃え）は
 * NFKC正規化でまとめて吸収しているので、各社の書式差は
 * 01_設定.gs の ラベル別名 に別名を足すだけで概ね吸収できる。
 */

/**
 * @param {GmailMessage} message
 * @return {Object|null} 反響オブジェクト。反響メールでなければ null
 */
function 反響を読む_(message) {
  return 反響を読む本文から_(
    message.getFrom(),
    message.getPlainBody(),
    message.getDate(),
    message.getId());
}

/**
 * 本体。Gmailに触らずに呼べるので、06_テスト.gs から実メールの文面で検証できる。
 * @param {string} from 差出人
 * @param {string} 生本文 プレーンテキスト本文
 * @param {Date} 受信日時 本文から日時が読めなかったときの代わり
 * @param {string} メッセージID
 * @return {Object|null}
 */
function 反響を読む本文から_(from, 生本文, 受信日時, メッセージID) {
  const 元 = 反響元一覧_().find(x => x.差出人.test(from));
  if (!元) return null;

  const 本文 = 本文を正規化_(生本文);
  const 項目 = 項目を抽出_(本文);

  const 反響 = {
    経路元: 元.名称,
    形式: 元.形式,
    日時: 日時を読む_(別名で拾う_(項目, '日時'), 受信日時),
    名前: 氏名を整える_(別名で拾う_(項目, '名前')),
    フリガナ: 氏名を整える_(別名で拾う_(項目, 'フリガナ')),
    電話番号: 電話番号を整える_(別名で拾う_(項目, '電話番号')),
    メールアドレス: (別名で拾う_(項目, 'メールアドレス') || '').trim(),
    物件名: 別名で拾う_(項目, '物件名'),
    賃料: 別名で拾う_(項目, '賃料'),
    所在地: 別名で拾う_(項目, '所在地'),
    間取り: 別名で拾う_(項目, '間取り'),
    問合せ内容: 問合せ内容を拾う_(項目, 本文, 元.形式),
    メッセージID: メッセージID,
    Gmailリンク: 'https://mail.google.com/mail/u/0/#all/' + メッセージID,
  };

  // 名前も電話もメールも取れていなければ、反響メールではない可能性が高い
  if (!反響.名前 && !反響.電話番号 && !反響.メールアドレス) return null;

  反響.反響経路 = 経路名を作る_(元, 反響.電話番号);
  return 反響;
}

/** 反響経路の表示名。例: suumo（番号あり） / アットホーム（番号無し） */
function 経路名を作る_(元, 電話番号) {
  if (!元.番号有無) return 元.名称;
  return 元.名称 + (電話番号 ? '（番号あり）' : '（番号無し）');
}

/**
 * NFKC正規化で、ＴＥＬ→TEL、：→:、全角スペース→半角スペース、
 * ＜＞→<> などをまとめて統一する。改行コードもLFに揃える。
 */
function 本文を正規化_(text) {
  return String(text || '').normalize('NFKC').replace(/\r\n?/g, '\n');
}

/**
 * 「ラベル：値」の行を全部拾って辞書にする。
 * ラベル中の空白は落とす（アットホームは全角スペースで桁を揃えているため）。
 * 同じラベルが複数あるときは、最初に見つかった空でない値を採る。
 */
function 項目を抽出_(本文) {
  const 辞書 = {};
  本文.split('\n').forEach(line => {
    const m = line.match(/^\s*([^\s:][^:]{0,24}?)\s*:\s*(.*)$/);
    if (!m) return;
    const ラベル = m[1].replace(/\s/g, '');
    const 値 = m[2].trim();
    if (!(ラベル in 辞書) || (!辞書[ラベル] && 値)) 辞書[ラベル] = 値;
  });
  return 辞書;
}

/** ラベル別名の表を順に当てて、最初に見つかった値を返す。 */
function 別名で拾う_(辞書, 種別) {
  const 候補 = ラベル別名[種別] || [];
  for (let i = 0; i < 候補.length; i++) {
    const 値 = 辞書[候補[i].replace(/\s/g, '')];
    if (値) return 値;
  }
  return '';
}

/**
 * 問合せ内容。
 * suumo は「お問合せ内容」「お問合せ内容コメント」の両方が入ることがあるので繋げる。
 * アットホームは <物件に関するお問合せ内容> の下に「・資料を送って欲しい」と箇条書きで来る。
 */
function 問合せ内容を拾う_(辞書, 本文, 形式) {
  const 断片 = [];

  ['お問合せ内容', 'お問合せ内容コメント', 'お問い合わせ内容', 'ご要望', 'ご質問']
    .forEach(k => { if (辞書[k] && 断片.indexOf(辞書[k]) < 0) 断片.push(辞書[k]); });

  if (形式 === 'athome') {
    const 節 = 節を切り出す_(本文, /<物件に関するお問合せ内容>/, /^[-—]{5,}\s*$/);
    節.split('\n')
      .map(s => s.replace(/^[・･]\s*/, '').trim())
      .filter(s => s)
      .forEach(s => { if (断片.indexOf(s) < 0) 断片.push(s); });
  }

  if (!断片.length) 断片.push(別名で拾う_(辞書, '問合せ内容'));
  return 断片.filter(s => s).join(' / ');
}

/** 開始の目印の次の行から、終了の目印の手前までを返す。 */
function 節を切り出す_(本文, 開始, 終了) {
  const 行 = 本文.split('\n');
  const i = 行.findIndex(l => 開始.test(l));
  if (i < 0) return '';
  const 集め = [];
  for (let j = i + 1; j < 行.length; j++) {
    if (終了.test(行[j])) break;
    集め.push(行[j]);
  }
  return 集め.join('\n');
}

/**
 * 日時文字列を Date にする。読めなければ既定値（メールの受信日時）を返す。
 * 対応: 2026/9/15 10:56:24 ／ 2026年09月15日22時04分 ／ 2026-09-15 22:04
 */
function 日時を読む_(文字列, 既定) {
  const s = String(文字列 || '');
  let m = s.match(/(\d{4})[\/年\-](\d{1,2})[\/月\-](\d{1,2})日?\D{0,3}(\d{1,2})[:時](\d{1,2})/);
  if (m) return new Date(+m[1], +m[2] - 1, +m[3], +m[4], +m[5]);
  m = s.match(/(\d{4})[\/年\-](\d{1,2})[\/月\-](\d{1,2})/);
  if (m) return new Date(+m[1], +m[2] - 1, +m[3]);
  return 既定;
}

/** 氏名の余分な空白を整理する（全角スペース1つは残す）。 */
function 氏名を整える_(s) {
  return String(s || '').replace(/\s+/g, ' ').trim();
}

/**
 * 電話番号の整形。
 * 携帯（070/080/090で始まる11桁）だけハイフンを入れる。
 * 固定電話は市外局番の桁数が地域で違い、機械的に割ると誤るのでそのまま残す。
 */
function 電話番号を整える_(s) {
  const 元 = String(s || '').trim();
  if (!元 || /^(なし|無し|-)$/.test(元)) return '';
  const 数字 = 元.replace(/[^\d]/g, '');
  if (/^0[789]0\d{8}$/.test(数字)) {
    return 数字.slice(0, 3) + '-' + 数字.slice(3, 7) + '-' + 数字.slice(7);
  }
  return 元;
}
