/**
 * 06_テスト.gs … Gmailにもシートにも触らずに解析を確認する
 *
 *  テスト_解析()       貼り付けた実メールの文面で、項目が正しく取れるか確認
 *  テスト_返信案()     その反響に対する返信案を表示
 *  テスト_生メールを見る() 新しい経路を足すとき、実メールの差出人と本文を確認
 *
 * 実行後 [実行ログ] を開くと結果が出る。
 */

function テスト_解析() {
  検体一覧_().forEach(検体 => {
    const 反響 = 反響を読む本文から_(検体.from, 検体.本文, new Date(), 'TEST-' + 検体.名);
    Logger.log('───── %s ─────', 検体.名);
    if (!反響) { Logger.log('！ 反響として認識されませんでした（差出人の判定を確認）'); return; }
    Logger.log([
      '反響経路 : ' + 反響.反響経路,
      '反響日時 : ' + Utilities.formatDate(反響.日時, 設定.タイムゾーン, 'yyyy/MM/dd HH:mm'),
      '名前     : ' + 反響.名前,
      'フリガナ : ' + 反響.フリガナ,
      '電話番号 : ' + 反響.電話番号,
      'メール   : ' + 反響.メールアドレス,
      '物件名   : ' + 反響.物件名,
      '賃料     : ' + 反響.賃料,
      '所在地   : ' + 反響.所在地,
      '間取り   : ' + 反響.間取り,
      '問合せ   : ' + 反響.問合せ内容,
    ].join('\n'));
  });
}

function テスト_返信案() {
  検体一覧_().forEach(検体 => {
    const 反響 = 反響を読む本文から_(検体.from, 検体.本文, new Date(), 'TEST-' + 検体.名);
    if (!反響) return;
    Logger.log('───── %s（用件: %s）─────\n宛先: %s\n件名: %s\n下書き: %s\n\n%s',
      検体.名,
      問合せ種別を判定_(反響.問合せ内容),
      反響.メールアドレス || '（なし）',
      件名を作る_(反響),
      下書きの見込み_(反響),
      返信案を作る_(反響));
  });
}

/** 新しい経路を足すとき用。ラベル「反響」の直近メールの差出人と冒頭を出す。 */
function テスト_生メールを見る() {
  GmailApp.search('label:反響 newer_than:14d', 0, 10).forEach(t => {
    t.getMessages().forEach(m => {
      Logger.log('───── From: %s / 件名: %s ─────\n%s',
        m.getFrom(), m.getSubject(),
        本文を正規化_(m.getPlainBody()).slice(0, 1200));
    });
  });
}

