/**
 * 05_返信案.gs … 返信文の下ごしらえ
 *
 * 方針
 *  1. まずテンプレート＋差し込みで、そのまま送れる文面を作る（無料・確実）
 *  2. 設定.AIで返信文を作る が true なら Claude API で清書する
 *  3. AIが失敗したらテンプレートのまま使う（業務を止めない）
 *  4. 出力先は Gmail の「下書き」だけ。シートには書かない
 *  5. ★自動送信は一切しない
 */

function 返信案を作る_(反響) {
  const 種別 = 問合せ種別を判定_(反響.問合せ内容);
  const 下書き = テンプレートで作る_(反響, 種別);
  if (!設定.AIで返信文を作る) return 下書き;
  const 清書 = AIで清書_(反響, 種別, 下書き);
  return 清書 || 下書き;
}

/** 問合せ内容の文言から用件を分類する。 */
function 問合せ種別を判定_(内容) {
  const s = String(内容 || '');
  if (/空室|空き|募集中|まだ.*空/.test(s))            return '空室確認';
  if (/資料|図面|間取り図|パンフ/.test(s))            return '資料請求';
  if (/内見|内覧|見学|下見|お部屋を見/.test(s))       return '内見希望';
  if (/来店|ご来店|訪問|伺/.test(s))                  return '来店希望';
  if (/家賃|初期費用|費用|見積|条件/.test(s))         return '費用相談';
  return 'その他';
}

function テンプレートで作る_(反響, 種別) {
  const 様 = (反響.名前 ? 反響.名前 : 'ご担当') + ' 様';
  const 物件 = 反響.物件名 || 'お問い合わせの物件';
  const 経路 = 反響.経路元 === 'suumo' ? 'SUUMO'
             : 反響.経路元 === 'アットホーム' ? 'アットホーム'
             : '弊社ホームページ';

  const 本題 = {
    '空室確認':
      '恐れ入りますが、' + 物件 + 'の最新の空室状況をお調べのうえ、\n'
      + '本日中に改めてご連絡いたします。\n\n'
      + 'なお、ご希望の条件（ご入居時期・ご予算・間取り・エリアなど）をお聞かせいただけますと、\n'
      + '条件の近い他のお部屋も併せてご案内できます。',
    '資料請求':
      物件 + 'の資料をお送りいたします。\n'
      + '送付先（ご住所またはメール添付のご希望）をお知らせください。\n\n'
      + '実際にご覧いただくのが一番わかりやすいかと存じますので、\n'
      + 'ご都合のよい日時をいただければ現地をご案内いたします。',
    '内見希望':
      物件 + 'のご見学を承ります。\n'
      + 'ご都合のよい日時を2〜3ほどお知らせいただけますでしょうか。\n'
      + '空室であれば当日中のご案内も可能です。',
    '来店希望':
      'ご来店をお待ちしております。\n'
      + 'ご都合のよい日時をお知らせいただけますでしょうか。\n'
      + '事前にご希望条件を伺っておけば、当日ご覧いただけるお部屋をご用意しておきます。',
    '費用相談':
      物件 + 'のお家賃・初期費用について、詳細をお見積りしてご連絡いたします。\n'
      + 'ご入居予定時期をお知らせいただけますと、より正確なお見積りが可能です。',
    'その他':
      物件 + 'についてお問い合わせいただいた件、確認のうえ改めてご連絡いたします。\n'
      + 'お急ぎの場合はお電話でも承っております。',
  }[種別];

  return [
    様,
    '',
    'お世話になっております。',
    設定.店舗名 + ' の ' + 設定.担当者名 + ' と申します。',
    'この度は' + 経路 + 'より' + 物件 + 'へお問い合わせいただき、誠にありがとうございます。',
    '',
    本題,
    '',
    'ご不明な点がございましたら、お気軽にお申し付けください。',
    'どうぞよろしくお願いいたします。',
    '',
    '────────────────────',
    設定.店舗名,
    '担当：' + 設定.担当者名,
    'TEL：' + 設定.自社電話,
    '住所：' + 設定.自社住所,
    '営業時間：' + 設定.営業時間 + '（定休日：' + 設定.定休日 + '）',
    '────────────────────',
  ].join('\n');
}

/**
 * 件名。
 * お客様から直接メールを受け取ったわけではない（SUUMO等が中継している）ので
 * 「Re：」は付けない。
 */
function 件名を作る_(反響) {
  const 物件 = 反響.物件名 || 'お問い合わせ';
  return '【' + 設定.店舗名 + '】' + 物件 + ' のお問い合わせありがとうございます';
}

/**
 * 署名に差し込む自社情報が ★ のままでないか調べる。
 *
 * ダミーの電話番号や住所が入ったまま下書きを作ると、
 * 人が中身を書き直して送ったときに「TEL：0000-00-0000」が
 * お客様にそのまま届いてしまう。未設定なら下書きを作らない。
 *
 * @return {string[]} まだ ★ のままの項目名。空なら問題なし
 */
function 自社情報の未設定_() {
  const 未設定 = [];
  const 電話 = String(設定.自社電話 || '').replace(/\s/g, '');
  if (!電話 || /^[0\-]+$/.test(電話)) 未設定.push('自社電話');
  const 住所 = String(設定.自社住所 || '');
  if (!住所 || /[○◯]/.test(住所)) 未設定.push('自社住所');
  if (!String(設定.店舗名 || '').trim()) 未設定.push('店舗名');
  if (!String(設定.担当者名 || '').trim()) 未設定.push('担当者名');
  return 未設定;
}

/** 未設定があればログに大きく出す。取込のたびに気づけるように。 */
function 自社情報を確かめる_() {
  const 未設定 = 自社情報の未設定_();
  if (未設定.length) {
    Logger.log('■■ 01_設定.gs の %s が ★ のままです。'
      + 'ダミーの連絡先がお客様に届かないよう、下書きの作成を止めています。'
      + '実際の値に直してください。 ■■', 未設定.join('・'));
  }
  return 未設定;
}

/** 返信できるメールアドレスを持っているか。 */
function 宛先がある_(反響) {
  const a = String(反響.メールアドレス || '').trim();
  return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(a);
}

/**
 * Gmailの下書きを作る。宛先はお客様のアドレス。★送信はしない。
 * 文面を組み立てるのもここ。シートには一切書かない。
 *
 * メールアドレスがない反響（電話のみ）は下書きを作らない。
 * その場合はシートの電話番号を見て架電する運用になる。
 *
 * @return {boolean} 下書きを作ったか
 */
function 下書きを作る_(反響) {
  if (自社情報の未設定_().length) return false;  // 理由は 自社情報を確かめる_ がログに出す
  if (!宛先がある_(反響)) {
    Logger.log('下書きなし（メールアドレスなし）: %s / %s',
      反響.名前 || '名前不明', 反響.電話番号 || '電話番号もなし');
    return false;
  }
  try {
    GmailApp.createDraft(反響.メールアドレス, 件名を作る_(反響), 返信案を作る_(反響));
    return true;
  } catch (e) {
    // 下書きが作れなくてもシートの行は残す。あとで手で返信すればよい
    Logger.log('下書きの作成に失敗: %s / %s', 反響.メールアドレス, e.message);
    return false;
  }
}

/** 試し取込で「下書きが作られるかどうか」だけを表示する（文面は作らない）。 */
function 下書きの見込み_(反響) {
  const 未設定 = 自社情報の未設定_();
  if (未設定.length) return '作らない（01_設定.gs の ' + 未設定.join('・') + ' が ★ のまま）';
  if (!設定.下書きを作る) return '作らない（設定でOFF）';
  if (!宛先がある_(反響)) return '作らない（メールアドレスなし → 電話で対応）';
  return '作る（宛先 ' + 反響.メールアドレス + '）';
}

// ───────────────────────────────────────────────
// AI清書（任意）
//
// 使うとき:
//   1. https://console.anthropic.com/ でAPIキーを発行
//   2. Apps Script の [プロジェクトの設定] → [スクリプト プロパティ] に
//      ANTHROPIC_API_KEY という名前で値を登録
//   3. 01_設定.gs の AIで返信文を作る を true にする
//
// 注意: お客様の氏名・電話番号が外部APIに送られる。抵抗がある場合は
//       false のままテンプレート運用で十分に実用になる。
// ───────────────────────────────────────────────

function AIで清書_(反響, 種別, 下書き) {
  const キー = PropertiesService.getScriptProperties().getProperty('ANTHROPIC_API_KEY');
  if (!キー) {
    Logger.log('ANTHROPIC_API_KEY が未設定のため、テンプレートのまま使います。');
    return null;
  }

  const 指示 = [
    'あなたは日本の賃貸・売買仲介店のベテラン営業担当です。',
    '反響（問い合わせ）に対する初回返信メールの本文を書いてください。',
    '',
    '守ること:',
    '- 敬体。過度にへりくだらず、簡潔で読みやすく。全体で400字以内。',
    '- 空室状況・賃料・入居可否など、与えられていない事実を断定しない。',
    '  未確認のことは「確認のうえご連絡します」と書く。',
    '- 次の一手（内見日時の候補、希望条件のヒアリング）を必ず1つ入れる。',
    '- 署名は下書きのものをそのまま末尾に残す。',
    '- 出力は本文のみ。前置き・解説・見出しを付けない。',
  ].join('\n');

  const 材料 = [
    '【反響の内容】',
    '反響経路: ' + 反響.反響経路,
    'お名前: ' + (反響.名前 || '不明'),
    '物件名: ' + (反響.物件名 || '不明'),
    '賃料/価格: ' + (反響.賃料 || '不明'),
    '所在地: ' + (反響.所在地 || '不明'),
    '間取り: ' + (反響.間取り || '不明'),
    '問合せ内容: ' + (反響.問合せ内容 || '不明'),
    '用件の分類: ' + 種別,
    '',
    '【たたき台（これを土台に、自然な日本語に整えてください）】',
    下書き,
  ].join('\n');

  try {
    const res = UrlFetchApp.fetch('https://api.anthropic.com/v1/messages', {
      method: 'post',
      contentType: 'application/json',
      muteHttpExceptions: true,
      headers: {
        'x-api-key': キー,
        'anthropic-version': '2023-06-01',
        'anthropic-beta': 'server-side-fallback-2026-07-01',
      },
      payload: JSON.stringify({
        model: 設定.AIモデル,
        max_tokens: 8000,
        output_config: { effort: 'low' },
        fallbacks: 'default',
        system: 指示,
        messages: [{ role: 'user', content: 材料 }],
      }),
    });

    if (res.getResponseCode() !== 200) {
      Logger.log('AI清書に失敗（HTTP %s）: %s', res.getResponseCode(), res.getContentText());
      return null;
    }
    const json = JSON.parse(res.getContentText());
    if (json.stop_reason === 'refusal') {
      Logger.log('AI清書が拒否されました。テンプレートのまま使います。');
      return null;
    }
    const 文 = (json.content || [])
      .filter(b => b.type === 'text')
      .map(b => b.text)
      .join('')
      .trim();
    return 文 || null;
  } catch (e) {
    Logger.log('AI清書で例外: %s', e.message);
    return null;
  }
}
